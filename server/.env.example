# ─────────────────────────────────────────────────────────────
# CareerPilot Backend Environment Variables
# ─────────────────────────────────────────────────────────────

# Server Environment & Port
PORT=5000
NODE_ENV=development # Set to 'production' in production deployments

# Frontend Client URL for CORS Whitelisting
# In development: http://localhost:5173
# In production: https://careerpilot.vercel.app (or your custom domain)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas or local instance)
# Local: mongodb://localhost:27017/careerpilot
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/careerpilot

# JWT Authentication
# In production, use a high-entropy 64-character random string
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/resumes

# Google Gemini & LangChain AI Configuration
# Obtain your Gemini API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chroma Vector Database Configuration
# Local Chroma daemon: http://localhost:8000
# Hosted Chroma / Docker: http://chromadb:8000
# Note: If Chroma is unreachable, CareerPilot automatically falls back to
# an in-memory cosine-similarity vector store with zero downtime.
CHROMA_URL=http://localhost:8000
